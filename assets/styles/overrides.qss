/*
   SyncroJob - Global UI Overrides (Enterprise Spectacular)
   Forza il tema chiaro su componenti critici e modernizza i componenti PyQt6 standard.
*/

/* === GLOBAL DIALOGS & WINDOWS === */
QDialog, QMainWindow {
    background-color: {{bg_white}};
    color: {{text_dark}};
}

QDialog QWidget {
    background-color: {{bg_white}};
    color: {{text_dark}};
}

/* === MODERN SCROLLBARS (Minimalist & Smooth) === */
QScrollBar:vertical {
    border: none;
    background: {{bg_light}};
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: {{border_dark}};
    min-height: 30px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: {{text_muted}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: {{bg_light}};
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: {{border_dark}};
    min-width: 30px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: {{text_muted}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === MODERN CONTEXT MENUS (Rounded & Airy) === */
QMenu {
    background-color: {{bg_white}};
    color: {{text_dark}};
    border: 1px solid {{border_light}};
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    background-color: transparent;
    padding: 8px 25px 8px 10px;
    border-radius: 5px;
    margin: 2px 5px;
}

QMenu::item:selected {
    background-color: {{bg_hover}};
    color: {{primary_dark}};
}

QMenu::separator {
    height: 1px;
    background: {{border_light}};
    margin: 5px 10px;
}

QMenu::icon {
    padding-left: 10px;
}

/* === MODERN TABLE HEADERS === */
QHeaderView::section {
    background-color: {{bg_light}};
    color: {{text_muted}};
    border: none;
    border-bottom: 2px solid {{border_light}};
    padding: 10px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    background-color: {{bg_hover}};
    color: {{text_dark}};
}

/* === MODERN CHECKBOXES & RADIO BUTTONS === */
QCheckBox::indicator, QGroupBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid {{border_dark}};
    background: {{bg_white}};
}

QCheckBox::indicator:hover {
    border-color: {{primary_blue}};
}

QCheckBox::indicator:checked {
    background-color: {{primary_blue}};
    border-color: {{primary_blue}};
    image: url(assets/icons/check.svg); /* Assicurati che l'icona esista */
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid {{border_dark}};
    background: {{bg_white}};
}

QRadioButton::indicator:checked {
    background-color: {{primary_blue}};
    border: 4px solid {{bg_white}};
}

/* === MODERN SPLITTER (Subtle Handle) === */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 4px;
    image: url(assets/icons/drag-handle-vertical.svg); /* Placeholder o riga sottile */
}

QSplitter::handle:vertical {
    height: 4px;
    image: url(assets/icons/drag-handle-horizontal.svg);
}

/* === UNIFIED TOOLTIPS (Light Mode - High Contrast) === */
QToolTip {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #BBBBBB;
    border-radius: 6px;
    padding: 8px 12px;
}

/* === TREE & LIST WIDGETS === */
QTreeWidget, QTreeView, QListWidget {
    background-color: {{bg_white}};
    color: {{text_dark}};
    border: 1px solid {{border_light}};
    border-radius: 8px;
    outline: none;
}

QTreeWidget::item, QTreeView::item, QListWidget::item {
    padding: 8px;
    border-radius: 4px;
    margin: 1px 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: {{bg_light}};
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: {{table_selection_bg}};
    color: {{primary_dark}};
    font-weight: 600;
}

/* === COMBOBOX POPUP === */
QComboBox QAbstractItemView {
    border: 1px solid {{border_light}};
    border-radius: 8px;
    background-color: {{bg_white}};
    selection-background-color: {{bg_hover}};
    selection-color: {{primary_dark}};
    outline: none;
    padding: 4px;
}

/* === TABLE CORNER BUTTON (Top Left) === */
QTableWidget QTableCornerButton::section, QTableView QTableCornerButton::section {
    background-color: {{bg_light}};
    border: none;
    border-right: 1px solid {{border_light}};
    border-bottom: 2px solid {{border_light}};
}

/* === SLIDER STYLE === */
QSlider::groove:horizontal {
    border: 1px solid {{border_light}};
    height: 6px;
    background: {{bg_alt}};
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: {{primary_blue}};
    border: 1px solid {{primary_dark}};
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: {{primary_variant}};
}

/* === COMBOBOX REFINEMENT === */
QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(assets/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}
