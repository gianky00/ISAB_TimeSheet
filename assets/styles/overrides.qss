/*
   SyncroJob - Global UI Overrides
   Forza il tema chiaro su componenti critici che potrebbero ereditare stili dal sistema operativo.
*/

/* FORCE LIGHT THEME ON ALL DIALOGS AND MENUS */
QDialog, QMainWindow {
    background-color: {{bg_white}};
    color: {{text_dark}};
}

/* Force all widgets INSIDE a Dialog to be light */
QDialog QWidget {
    background-color: {{bg_white}};
    color: {{text_dark}};
}

/* But allow specific widgets to have their own backgrounds (like buttons) */
QDialog QPushButton {
    background-color: {{bg_light}};
    border: 1px solid {{border_medium}};
    border-radius: 4px;
    padding: 5px 10px;
}

QDialog QPushButton:hover {
    background-color: {{bg_hover}};
}

QDialog QLabel, QDialog QCheckBox {
    background-color: transparent; /* inherit white from parent */
    color: {{text_dark}};
}

QMenu {
    background-color: {{bg_white}};
    color: {{text_dark}};
    border: 1px solid {{border_medium}};
}

QMenu::item {
    background-color: transparent;
    color: {{text_dark}};
    padding: 6px 20px;
}

QMenu::item:selected {
    background-color: {{bg_hover}};
    color: {{text_dark}};
}

QMenuBar {
    background-color: {{bg_white}};
    color: {{text_dark}};
}

QMenuBar::item {
    background-color: transparent;
    color: {{text_dark}};
}

QMenuBar::item:selected {
    background-color: {{bg_hover}};
}

/* Tree View Force Light */
QTreeWidget, QTreeView {
    background-color: {{bg_white}};
    color: {{text_dark}};
    alternate-background-color: {{bg_light}};
    border: 1px solid {{border_light}};
    selection-background-color: {{bg_hover}};
    selection-color: {{text_dark}};
}

QTreeWidget::item, QTreeView::item {
    color: {{text_dark}};
}

QTreeWidget::item:hover {
     background-color: {{bg_light}};
     color: {{text_dark}};
}

QTreeWidget::item:selected {
    background-color: {{bg_hover}};
    color: {{text_dark}};
}

QHeaderView::section {
    background-color: {{bg_light}};
    color: {{text_dark}};
    border: none;
    border-bottom: 2px solid {{border_light}};
    padding: 4px;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: {{bg_alt}};
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: {{border_medium}};
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tooltips */
QToolTip {
    background-color: {{bg_white}};
    color: {{on_surface}};
    border: 1px solid {{border_dark}};
    border-radius: 4px;
    padding: 5px;
}
