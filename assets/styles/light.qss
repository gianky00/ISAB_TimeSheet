/* Bot TS Light Theme Stylesheet */

/* === GLOBAL === */
* {
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #FAFAFA;
}

QWidget {
    color: #212121;
}

/* === BUTTONS === */
QPushButton {
    background-color: #009688;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #00897B;
}

QPushButton:pressed {
    background-color: #00796B;
}

QPushButton:disabled {
    background-color: #BDBDBD;
    color: #757575;
}

QPushButton:focus {
    outline: 2px solid #00968866;
    outline-offset: 2px;
}

/* Secondary Button */
QPushButton[variant="secondary"] {
    background-color: #673AB7;
}

QPushButton[variant="secondary"]:hover {
    background-color: #5E35B1;
}

/* Ghost Button */
QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #009688;
    border: 1px solid #009688;
}

QPushButton[variant="ghost"]:hover {
    background-color: #00968811;
}

/* === INPUTS === */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #FFFFFF;
    color: #212121; /* Force Text Color */
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 10px 12px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #009688;
    outline: none;
    background-color: #FFFFFF; /* Ensure background stays white */
    color: #000000; /* Force Black Text on Focus */
}

/* Specific fix for QTableWidget Inputs to prevent shrinking/disappearing text */
QTableWidget QLineEdit, QTableWidget QComboBox {
    color: #000000;
    background-color: #FFFFFF;
    font-size: 14px;
    padding: 0px 4px; /* Reduced padding */
    margin: 0px;      /* Reset margin */
    border: none;
    min-height: 24px; /* Ensure minimum height matching font */
}

QLineEdit:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

/* === TABLES (QTableWidget & QTableView) === */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFAFA;
    gridline-color: #EEEEEE;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    selection-background-color: #00968850; /* Stronger Teal (30% opacity) for visibility */
    selection-color: #212121; /* Keep text black for readability over colors */
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #F5F5F5;
}

/* Clear Selection: Visible background + Solid Border */
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #E0F2F1; /* Very Light Teal */
    color: #000000;
    border: none;
    border-left: 3px solid #009688; /* Elegant accent */
}

/* Indicator for focused selection */
QTableWidget::item:focus, QTableView::item:focus {
    background-color: #00968860; /* Slightly darker on focus */
}

QHeaderView::section {
    background-color: #E1F5FE; /* Standard Light Blue Header */
    color: #333333;
    padding: 12px 15px;
    border: none;
    border-right: 1px solid #B3E5FC;
    border-bottom: 2px solid #81D4FA;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 13px;
}

QHeaderView::section:vertical {
    background-color: #F5F5F5;
    color: #9E9E9E;
    font-size: 10px;
    padding: 0px 5px;
    border-right: 1px solid #E0E0E0;
}

QHeaderView::section:hover {
    background-color: #B3E5FC;
}

/* === LEVEL 2 TABS (Sottomenu) === */
QTabWidget[class="Level2Tabs"]::pane {
    border: none;
    border-top: 1px solid #CFD8DC; /* Thin separator line */
    background: white;
}

QTabWidget[class="Level2Tabs"] > QTabBar::tab {
    background: transparent;
    color: #546E7A; /* Blue Grey */
    border: none;
    border-bottom: 3px solid transparent; /* Reserve space for indicator */
    padding: 10px 16px;
    margin-right: 4px;
    font-weight: 600;
    font-size: 13px;
    min-width: 110px;
}

QTabWidget[class="Level2Tabs"] > QTabBar::tab:selected {
    color: #00897B; /* Teal Accent */
    border-bottom: 3px solid #00897B;
    background-color: transparent; /* No background change, clean look */
}

QTabWidget[class="Level2Tabs"] > QTabBar::tab:hover:!selected {
    color: #00897B;
    background-color: #F5F5F5; /* Subtle hover */
    border-radius: 4px 4px 0 0;
}

/* Fix for icons in tabs (handled by Qt automatically, but ensures color contrast if SVG allows) */

/* === SCROLLBARS === */
QScrollBar:vertical {
    background-color: #F5F5F5;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #BDBDBD;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9E9E9E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === PROGRESS BAR === */
QProgressBar {
    background-color: #E0E0E0;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #009688;
    border-radius: 4px;
}

/* === TOOLTIPS === */
QToolTip {
    background-color: #FFFFFF;
    color: #424242;
    border: 1px solid #BDBDBD;
    padding: 8px 12px;
    border-radius: 4px;
}

/* === GROUP BOX === */
QGroupBox {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 20px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: #009688;
    font-weight: 600;
}

/* === STATUS COLORS (Generic Classes) === */
.status-success {
    background-color: #C8E6C9;
}

.status-error {
    background-color: #FFCDD2;
}

.status-warning {
    background-color: #FFF9C4;
}

.status-pending {
    background-color: #E3F2FD;
}
