/* Bot TS Light Theme Stylesheet */

/* === GLOBAL === */
* {
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: {{background}};
}

QWidget {
    color: {{on_background}};
}

/* === BUTTONS === */
QPushButton {
    background-color: {{primary}};
    color: {{on_primary}};
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: {{primary_variant}};
}

QPushButton:pressed {
    background-color: {{primary_variant}};
}

QPushButton:disabled {
    background-color: {{disabled}};
    color: {{text_light}};
}

QPushButton:focus {
    outline: 2px solid {{focus}};
    outline-offset: 2px;
}

/* Secondary Button */
QPushButton[variant="secondary"] {
    background-color: {{secondary}};
}

QPushButton[variant="secondary"]:hover {
    background-color: {{secondary_variant}};
}

/* Ghost Button */
QPushButton[variant="ghost"] {
    background-color: transparent;
    color: {{primary}};
    border: 1px solid {{primary}};
}

QPushButton[variant="ghost"]:hover {
    background-color: {{hover}};
}

/* === INPUTS === */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: {{surface}};
    color: {{on_background}}; /* Force Text Color */
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 10px 12px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: {{primary}};
    outline: none;
    background-color: {{surface}}; /* Ensure background stays white */
    color: {{text_dark}}; /* Force Black Text on Focus */
}

/* Specific fix for QTableWidget Inputs to prevent shrinking/disappearing text */
QTableWidget QLineEdit, QTableWidget QComboBox {
    color: {{text_dark}};
    background-color: {{surface}};
    font-size: 14px;
    padding: 0px 4px; /* Reduced padding */
    margin: 0px;      /* Reset margin */
    border: none;
    min-height: 24px; /* Ensure minimum height matching font */
}

QLineEdit:disabled {
    background-color: {{surface_variant}};
    color: {{disabled}};
}

/* === TABLES (QTableWidget & QTableView) === */
QTableWidget, QTableView {
    background-color: {{surface}};
    alternate-background-color: {{background}};
    gridline-color: {{divider}};
    border: 1px solid {{border}};
    border-radius: 8px;
    selection-background-color: {{table_selection_bg}};
    selection-color: {{text_dark}};
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid {{divider}};
}

/* Clean Selection: Soft Teal background, no borders */
QTableWidget::item:selected, QTableView::item:selected {
    background-color: {{table_selection_bg}};
    color: {{text_dark}};
    border: none;
}

/* Current cell indicator */
QTableWidget::item:focus, QTableView::item:focus {
    background-color: {{table_info_bg}}; /* Slightly stronger Teal for current cell */
}

QHeaderView::section {
    background-color: {{table_info_bg}}; /* Standard Light Blue Header */
    color: {{text_dark}};
    padding: 12px 15px;
    border: none;
    border-right: 1px solid {{border}};
    border-bottom: 2px solid {{primary}};
    font-weight: bold;
    text-transform: uppercase;
    font-size: 13px;
}

QHeaderView::section:vertical {
    background-color: {{surface_variant}};
    color: {{disabled}};
    font-size: 10px;
    padding: 0px 5px;
    border-right: 1px solid {{border}};
}

QHeaderView::section:hover {
    background-color: {{table_selection_bg}};
}

/* === LEVEL 2 TABS (Sottomenu) === */
QTabWidget[class="Level2Tabs"]::pane {
    border: none;
    border-top: 1px solid {{border}}; /* Thin separator line */
    background: white;
}

QTabWidget[class="Level2Tabs"] > QTabBar::tab {
    background: transparent;
    color: {{text_muted}}; /* Blue Grey */
    border: none;
    border-bottom: 3px solid transparent; /* Reserve space for indicator */
    padding: 10px 16px;
    margin-right: 4px;
    font-weight: 600;
    font-size: 13px;
    min-width: 110px;
}

QTabWidget[class="Level2Tabs"] > QTabBar::tab:selected {
    color: {{primary}}; /* Teal Accent */
    border-bottom: 3px solid {{primary}};
    background-color: transparent; /* No background change, clean look */
}

QTabWidget[class="Level2Tabs"] > QTabBar::tab:hover:!selected {
    color: {{primary}};
    background-color: {{bg_light}}; /* Subtle hover */
    border-radius: 4px 4px 0 0;
}

/* Fix for icons in tabs (handled by Qt automatically, but ensures color contrast if SVG allows) */

/* === PROGRESS BAR === */
QProgressBar {
    background-color: {{border}};
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: {{primary}};
    border-radius: 4px;
}

/* === GROUP BOX === */
QGroupBox {
    border: 1px solid {{border}};
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 20px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: {{primary}};
    font-weight: 600;
}

/* === STATUS COLORS (Generic Classes) === */
.status-success {
    background-color: {{table_success_bg}};
}

.status-error {
    background-color: {{table_error_bg}};
}

.status-warning {
    background-color: {{table_warning_bg}};
}

.status-pending {
    background-color: {{table_info_bg}};
}

/* === SCROLL AREAS === */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: {{border}};
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{disabled}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 4px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: {{border}};
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{disabled}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}
